{
  "manifest_version": 3,
  "name": "東工大ポータル自動入力",
  "version": "1.2",
  "description": "東工大ポータル/Science Tokyoポータルのパスワードとマトリクスコードを自動入力します",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.nap.gsic.titech.ac.jp/GetAccess/*",
        "https://isct.ex-tic.com/auth/session",
        "https://lms.s.isct.ac.jp/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "options_ui": {
    "page": "option.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon/icon16.png",
    "48": "icon/icon48.png",
    "128": "icon/icon128.png"
  },
  "author": "U.N.ABC"
}